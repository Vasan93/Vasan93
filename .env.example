# ---- Database ----
DATABASE_URL=postgresql+psycopg://grandmaster:grandmaster@localhost:5432/grandmasterai

# ---- Cache / queue ----
REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Coaching brain (Anthropic Claude) ----
# Without a key the app still runs: coaching falls back to engine-grounded templates.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5

# ---- Engines ----
STOCKFISH_PATH=/usr/games/stockfish
LC0_PATH=
MAIA_WEIGHTS_DIR=engines/weights

# ---- App ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
