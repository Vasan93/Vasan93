# Copy this to .env and edit if you need to. It works as-is.
#
# These defaults run the app with no Docker, no database server and no cache server:
# the data goes in a single SQLite file and the cache lives in memory.
# Docker Compose overrides the database and cache settings with its own containers,
# so the same file is correct whichever way you start the app.

# ---- Database ----
# A file in the repository root. Nothing to install.
# For a real deployment use PostgreSQL instead, for example:
#   DATABASE_URL=postgresql+psycopg://grandmaster:grandmaster@localhost:5432/grandmasterai
DATABASE_URL=sqlite+pysqlite:///./grandmasterai.db

# ---- Cache ----
# Optional. Leave this commented out and the app uses an in-process cache, which is
# fine for one person. Redis is worth it when several people use the same server.
# REDIS_URL=redis://localhost:6379/0

# ---- Auth ----
# Leave blank for local use: a random key is generated each time the server starts,
# which signs everyone out on restart but is never a key published in this repository.
# Before deploying, set one:  openssl rand -hex 32
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- Coaching brain (Anthropic Claude) ----
# Without a key the app still runs, but coaching falls back to engine-grounded
# templates: correct, but plain, and English only. The chess is identical either way,
# because the engine decides every fact.
ANTHROPIC_API_KEY=
COACH_MODEL=claude-opus-5

# ---- Engines ----
# Stockfish is required. Point this at the binary you downloaded.
#   Windows:  STOCKFISH_PATH=C:\Vasan\Tools\stockfish\stockfish-windows-x86-64-avx2.exe
#   macOS:    STOCKFISH_PATH=/opt/homebrew/bin/stockfish
#   Linux:    STOCKFISH_PATH=/usr/games/stockfish
# Leave it blank and the app looks for `stockfish` on your PATH.
STOCKFISH_PATH=

# Optional, for human-like sparring. See engines/README.md.
LC0_PATH=
MAIA_WEIGHTS_DIR=engines/weights

# ---- App ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
